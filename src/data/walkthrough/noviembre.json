            {
              "note": true,
              "text": "<div class=\"table-wrap\"><table><tr><td></td><td><strong>Arma</strong></td><td><strong>Armadura</strong></td><td><strong>Calzado</strong></td><td><strong>Accesorio</strong></td></tr><tr><td><strong>Makoto</strong></td><td>Outenta Mitsuyo</td><td>Tigerhide Belt</td><td>Silent Sandals</td><td>Mega Master Band</td></tr><tr><td><strong>Yukari</strong></td><td>Whirlwind Bow</td><td>Rangda Robe</td><td>Killer Cleats / (comisaría)</td><td>Yellow Shawl / or Vayu Bracers</td></tr><tr><td><strong>Junpei</strong></td><td>Mikazuki Munechika</td><td>Samue of the Tengu</td><td>Silent Sandals</td><td>Power Enhancer</td></tr><tr><td><strong>Akihiko</strong></td><td>Champion Gloves</td><td>Tigerhide Belt</td><td>Silent Sandals</td><td>Blue Shawl / or Indra Bracers</td></tr><tr><td><strong>Mitsuru</strong></td><td>Aristocracy</td><td>Rangda Robe</td><td>Silent Sandals</td><td>Red Shawl / or Varna Bracers</td></tr><tr><td><strong>Aigis</strong></td><td>Blast Magnum</td><td>Fifth Number</td><td>Free Walkers</td><td>Yellow Shawl / or Pierce Bracers</td></tr><tr><td><strong>Koromaru</strong></td><td>Elementary Mask</td><td>Powered Dog Suit</td><td>Bare Paws</td><td>Dark Bracers</td></tr><tr><td><strong>Ken</strong></td><td>Gae Bolg</td><td>Tigerhide Belt</td><td>Silent Sandals</td><td>Light Bracers</td></tr></table></div>"
