---
import Layout from '../layouts/Layout.astro';
import TodayPanel from '../components/TodayPanel.astro';
import { MONTHS, EVENTS, CLASS_ANSWERS, TOTAL_ITEMS, ARCANA, dateOrd, formatDate } from '../data/walkthrough';

const STAT_ES: Record<string, string> = { Academics: 'Académicos', Charm: 'Encanto', Courage: 'Valentía' };
const arcanaName = (a: string) => ARCANA.find((x) => x.alias.some((y) => y.toLowerCase() === a.toLowerCase()))?.name ?? a;
const monthOfEvent = (date: string) => Number(date.split('/')[0]);
const KIND_ICON: Record<string, string> = { boss: '🔴', exam: '📝', tartarus: '🗼', deadline: '⏰', story: '📅' };
const isWarn = (t: string) => /^(⚠️|🔴|<strong>¡Importante)/.test(t) || /¡Importante!/.test(t);
---
<Layout title="Walkthrough Día a Día" section="walkthrough" description="Walkthrough completo de Persona 3 Reload en español — guía día a día con seguimiento de progreso">

  <section class="page-hero" data-pagefind-ignore>
    <p class="hero-eyebrow">Guía Completa · Día a Día</p>
    <h1 class="page-title"><span>Walkthrough</span> 100%</h1>
    <p class="page-subtitle">
      Cada acción, cada respuesta, cada decisión. Marcá lo que ya hiciste y seguí tu progreso.
      Basado en la guía de TenSquare3 (GameFAQs v2.5.0).
    </p>
  </section>

  <div class="content-wrap">

    <TodayPanel />

    <div class="wt-progress-box" data-pagefind-ignore>
      <div class="wt-progress-header">
        <span class="wt-progress-label">Progreso total</span>
        <span id="progress-text" class="wt-progress-count">0 / {TOTAL_ITEMS}</span>
      </div>
      <div class="wt-progress-track"><div id="progress-fill" class="wt-progress-fill" style="width:0%"></div></div>
      <div class="wt-toolbar">
        <button class="wt-btn wt-btn-primary" id="btn-next">⏭ Siguiente pendiente</button>
        <label class="wt-switch"><input type="checkbox" id="opt-spoilers" /> <span>Ocultar días futuros (spoilers)</span></label>
        <label class="wt-switch"><input type="checkbox" id="opt-hide-done" /> <span>Ocultar días completos</span></label>
        <button class="wt-btn wt-btn-sec" id="btn-collapse">Cerrar todos</button>
        <span class="wt-keys muted" title="Atajos de teclado">⌨ <kbd>N</kbd> pendiente · <kbd>T</kbd> hoy · <kbd>J</kbd>/<kbd>K</kbd> día sig./ant.</span>
      </div>
    </div>

    <div class="wt-view-switch" data-pagefind-ignore>
      <button class="wt-view-btn active" data-view="dia">✓ Día a Día</button>
      <button class="wt-view-btn" data-view="resumen">📅 Resumen Mensual</button>
      <button class="wt-view-btn" data-view="clase">📖 Respuestas de Clase</button>
    </div>

    <!-- ============ DÍA A DÍA ============ -->
    <div id="view-dia" class="wt-view">
      <nav class="month-tabs" id="month-tabs" data-pagefind-ignore>
        {MONTHS.map((m) => <a href={`#${m.key}`} class="month-tab" data-tab={m.key}>{m.short}<span class="tab-pct" data-tab-pct={m.key}>0%</span></a>)}
      </nav>

      {MONTHS.map((m) => (
        <section class="wt-month" id={m.key} data-month={m.key}>
          <h2 class="wt-month-header">
            <span>{m.title}</span>
            <span class="wt-month-pct" data-month-pct={m.key} data-pagefind-ignore>0%</span>
          </h2>
          {m.intro.length > 0 && (
            <div class="wt-month-intro">{m.intro.map((t) => <div class="wt-tip" set:html={t} />)}</div>
          )}

          {m.days.map((d) => {
            const ord = dateOrd(d.date);
            return (
              <article class="wt-day" id={`d-${d.id}`} data-day={d.id} data-ord={ord} data-month={m.key}>
                <div class="wt-day-header" role="button" tabindex="0" aria-expanded="false">
                  <h3 class="wt-day-h" id={`s-${d.id}`}><span class="wt-day-date">{d.date}</span> <span class="wt-day-title">{d.name}</span></h3>
                  <span class="wt-day-today" data-pagefind-ignore>HOY</span>
                  <span class="wt-day-check" data-pagefind-ignore>✓</span>
                  <span class="wt-day-mini-prog" data-day-prog={d.id} data-pagefind-ignore></span>
                  <span class="wt-day-toggle" data-pagefind-ignore>›</span>
                </div>
                <div class="wt-day-body">
                  <div class="wt-spoiler-cover" data-pagefind-ignore>
                    <span>Día futuro oculto para evitar spoilers.</span>
                    <button class="wt-btn wt-btn-sec" data-reveal>Mostrar igual</button>
                  </div>
                  {d.slots.map((s) => (
                    <div class="wt-slot">
                      <div class="wt-slot-label">{s.label}</div>
                      {s.items.map((it) =>
                        it.note ? (
                          <div class={`wt-note ${isWarn(it.text) ? 'wt-note-warn' : ''}`} set:html={it.text} />
                        ) : (
                          <div class="wt-check-item" data-check={`c:${it.id}`} id={`i-${it.id}`}>
                            <span class="wt-checkmark" aria-hidden="true"></span>
                            <div class="wt-check-body">
                              <span class="wt-check-text" set:html={it.text} />
                              {it.sub && it.sub.length > 0 && (
                                <ul class="wt-sub">{it.sub.map((x) => <li set:html={x} />)}</ul>
                              )}
                            </div>
                          </div>
                        )
                      )}
                    </div>
                  ))}
                  {d.tips && d.tips.length > 0 && (
                    <div class="wt-tips">{d.tips.map((t) => <div class={`wt-tip ${isWarn(t) ? 'wt-tip-warn' : ''}`} set:html={t} />)}</div>
                  )}
                  <div class="wt-day-foot" data-pagefind-ignore>
                    <textarea class="wt-note-input" data-bind={`n:${d.id}`} rows="1" placeholder="Tus notas de este día…"></textarea>
                    <button class="wt-btn wt-btn-sec" data-check-all>✓ Tildar todo el día</button>
                    <button class="wt-btn wt-btn-primary" data-finish-day title="Marca este día como tu fecha actual en el juego y abre el siguiente">Terminé el día →</button>
                  </div>
                </div>
              </article>
            );
          })}

          {m.checklist && (
            <div class="wt-eom" data-pagefind-ignore>
              <h4>📋 Cómo deberías terminar {m.key} según la guía</h4>
              <div class="wt-eom-cols">
                <div>
                  <div class="wt-eom-label">Stats sociales</div>
                  {m.checklist.stats.map((s) => <div class="wt-eom-item">📊 {STAT_ES[s.stat] ?? s.stat}: <strong>R{s.rank}</strong> <span class="muted">({s.label})</span></div>)}
                </div>
                <div>
                  <div class="wt-eom-label">Vínculos</div>
                  <div class="wt-eom-chips">{m.checklist.sl.map((s) => <span class="wt-chip">{arcanaName(s.arcana)} <strong>{s.rank === 10 ? 'MAX' : `R${s.rank}`}</strong></span>)}</div>
                </div>
                {m.checklist.trophies.length > 0 && (
                  <div>
                    <div class="wt-eom-label">Trofeos acumulados ({m.checklist.trophies.length})</div>
                    <div class="wt-eom-chips">{m.checklist.trophies.slice(-8).map((t) => <span class="wt-chip">🏆 {t}</span>)}{m.checklist.trophies.length > 8 && <span class="wt-chip muted">+{m.checklist.trophies.length - 8} más</span>}</div>
                  </div>
                )}
                {m.checklist.compendium > 0 && <div><div class="wt-eom-label">Compendio</div><div class="wt-eom-item">📕 {m.checklist.compendium} Personas registradas</div></div>}
              </div>
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- ============ RESUMEN ============ -->
    <div id="view-resumen" class="wt-view" hidden>
      <div class="callout callout-warn">
        <strong>Regla de oro:</strong> la guía sube cada bloque de Tartarus en una sola noche, justo antes de la luna llena.
        Llegá con las Personas y el yen que pide cada visita.
      </div>
      <div class="wt-cal-grid">
        {MONTHS.map((m) => {
          const evs = EVENTS.filter((e) => monthOfEvent(e.date) === m.num);
          const boss = evs.find((e) => e.kind === 'boss');
          return (
            <div class="wt-cal-card">
              <div class="wt-cal-header">
                <span class="wt-cal-month">{m.title.split('—')[0]}</span>
                {boss ? <span class="wt-cal-badge badge-boss">Jefe: {boss.date}</span> : <span class="wt-cal-badge">Sin jefe</span>}
              </div>
              <div class="wt-cal-body">
                {evs.map((e) => (
                  <a class={`wt-cal-row ${e.kind === 'boss' ? 'wt-cal-boss' : ''}`} href={`#d-${m.days.find((d) => dateOrd(d.date) >= dateOrd(e.date))?.id ?? ''}`} data-goto-view="dia">
                    <span class="wt-cal-ico">{KIND_ICON[e.kind]}</span>
                    <span><strong>{e.date}{e.end ? `–${e.end}` : ''}</strong> {e.title}{e.detail ? <span class="muted"> — {e.detail}</span> : ''}</span>
                  </a>
                ))}
                {m.checklist && (
                  <div class="wt-cal-row wt-cal-prio">
                    <span class="wt-cal-ico">🎯</span>
                    <span>Fin de mes: {m.checklist.stats.map((s) => `${STAT_ES[s.stat]} R${s.rank}`).join(', ')}</span>
                  </div>
                )}
                <div class="wt-cal-row muted"><span class="wt-cal-ico">✓</span><span>Progreso del mes: <strong data-month-pct={m.key}>0%</strong></span></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- ============ RESPUESTAS DE CLASE ============ -->
    <div id="view-clase" class="wt-view" hidden>
      <h2 class="section-title" style="margin-top:0">Respuestas en Clase y Exámenes</h2>
      <p class="muted" style="margin-bottom:1rem">
        Responder bien en clase da <strong style="color:var(--gold)">Encanto +1</strong>. Si quedás primero en los exámenes, Encanto +2 extra.
        Esta tabla sale directo de los datos del walkthrough.
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Fecha</th><th>Tipo</th><th>Respuesta</th></tr></thead>
          <tbody>
            {CLASS_ANSWERS.map((a) => (
              <tr class={a.exam ? 'row-exam' : ''}>
                <td><a href={`#d-${a.dayId}`} data-goto-view="dia">{a.date}</a></td>
                <td>{a.exam ? <span class="badge badge-gold">Examen</span> : <span class="badge badge-moon">Clase</span>}</td>
                <td><strong>{a.answer}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <button class="wt-fab" id="fab-next" aria-label="Ir al siguiente pendiente" title="Siguiente pendiente" data-pagefind-ignore>⏭</button>

  <script>
    import { store, dateOrd } from '../lib/store';

    const dayEls = [...document.querySelectorAll<HTMLElement>('.wt-day')];
    const itemsOf = new Map(dayEls.map((d) => [d, [...d.querySelectorAll<HTMLElement>('[data-check]')]]));
    const monthEls = [...document.querySelectorAll<HTMLElement>('.wt-month')];
    const total = [...itemsOf.values()].reduce((a, l) => a + l.length, 0);

    // ---------- progreso ----------
    function updateDay(day: HTMLElement) {
      const items = itemsOf.get(day)!;
      const done = items.filter((i) => store.has(i.dataset.check!)).length;
      day.classList.toggle('all-done', items.length > 0 && done === items.length);
      const p = day.querySelector('[data-day-prog]');
      if (p) p.textContent = items.length ? `${done}/${items.length}` : '';
      return done;
    }
    function updateAll() {
      let allDone = 0;
      const perMonth: Record<string, [number, number]> = {};
      for (const d of dayEls) {
        const done = updateDay(d);
        const m = d.dataset.month!;
        perMonth[m] ??= [0, 0];
        perMonth[m][0] += done;
        perMonth[m][1] += itemsOf.get(d)!.length;
        allDone += done;
      }
      for (const [m, [done, tot]] of Object.entries(perMonth)) {
        const pct = tot ? Math.round((done / tot) * 100) : 0;
        document.querySelectorAll(`[data-month-pct="${m}"]`).forEach((el) => { el.textContent = `${pct}% (${done}/${tot})`; });
        const tabPct = document.querySelector(`[data-tab-pct="${m}"]`);
        if (tabPct) tabPct.textContent = `${pct}%`;
        const tab = document.querySelector(`[data-tab="${m}"]`);
        tab?.classList.toggle('done', pct === 100);
        tab?.classList.toggle('in-progress', pct > 0 && pct < 100);
      }
      const pct = total ? Math.round((allDone / total) * 100) : 0;
      (document.getElementById('progress-fill') as HTMLElement).style.width = pct + '%';
      document.getElementById('progress-text')!.textContent = `${allDone} / ${total} completados (${pct}%)`;
      applyFilters();
    }

    // ---------- abrir / cerrar días ----------
    const setOpen = (day: HTMLElement, open: boolean) => {
      day.classList.toggle('open', open);
      day.querySelector('.wt-day-header')?.setAttribute('aria-expanded', String(open));
    };
    document.querySelectorAll<HTMLElement>('.wt-day-header').forEach((h) => {
      const day = h.closest<HTMLElement>('.wt-day')!;
      h.addEventListener('click', () => setOpen(day, !day.classList.contains('open')));
      h.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setOpen(day, !day.classList.contains('open')); } });
    });
    document.getElementById('btn-collapse')!.addEventListener('click', () => dayEls.forEach((d) => setOpen(d, false)));

    // tildar todo el día
    document.querySelectorAll<HTMLElement>('[data-check-all]').forEach((b) => b.addEventListener('click', () => {
      const items = itemsOf.get(b.closest<HTMLElement>('.wt-day')!)!;
      const allOn = items.every((i) => store.has(i.dataset.check!));
      const now = Date.now();
      store.merge(Object.fromEntries(items.map((i) => [i.dataset.check!, { v: allOn ? 0 : 1, t: now }])), 'local');
    }));

    // terminé el día: la fecha del juego pasa al día siguiente de la guía y se abre
    document.querySelectorAll<HTMLElement>('[data-finish-day]').forEach((b) => b.addEventListener('click', () => {
      const day = b.closest<HTMLElement>('.wt-day')!;
      const i = dayEls.indexOf(day);
      const next = dayEls[i + 1];
      if (!next) { store.set('cfg:date', '1/31'); return; }
      const [m, d] = day.querySelector('.wt-day-date')!.textContent!.split('/').map(Number);
      const dt = new Date(m >= 4 ? 2009 : 2010, m - 1, d + 1);
      store.set('cfg:date', `${dt.getMonth() + 1}/${dt.getDate()}`);
      setOpen(day, false);
      next.classList.add('revealed');
      setOpen(next, true);
      next.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));

    // atajos de teclado
    document.addEventListener('keydown', (e) => {
      const tgt = e.target instanceof Element ? e.target : null;
      if (e.ctrlKey || e.metaKey || e.altKey || tgt?.closest('input,textarea,select,dialog')) return;
      const k = e.key.toLowerCase();
      if (k === 'n') { e.preventDefault(); nextPending(); }
      else if (k === 't') { const t = currentDay(); if (t) { e.preventDefault(); gotoDay(t.dataset.day!); } }
      else if (k === 'j' || k === 'k') {
        e.preventDefault();
        const open = dayEls.filter((d) => d.classList.contains('open'));
        const ref = open[open.length - 1] ?? currentDay() ?? dayEls[0];
        const i = dayEls.indexOf(ref);
        let j = i;
        do { j += k === 'j' ? 1 : -1; } while (dayEls[j] && dayEls[j].style.display === 'none');
        const target = dayEls[j];
        if (target) { setOpen(ref, false); gotoDay(target.dataset.day!); }
      }
    });

    // spoilers: revelar un día puntual
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((b) => b.addEventListener('click', () => b.closest('.wt-day')!.classList.add('revealed')));

    // ---------- vistas ----------
    function switchView(v: string) {
      for (const x of ['dia', 'resumen', 'clase']) (document.getElementById('view-' + x) as HTMLElement).hidden = x !== v;
      document.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.classList.toggle('active', b.dataset.view === v));
    }
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.addEventListener('click', () => switchView(b.dataset.view!)));
    document.querySelectorAll<HTMLElement>('[data-goto-view]').forEach((a) => a.addEventListener('click', () => switchView('dia')));

    // ---------- navegación a un día / ítem ----------
    function flash(el: HTMLElement) { el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash'); }
    function gotoDay(id: string, smooth = true) {
      const day = document.getElementById('d-' + id);
      if (!day) return;
      switchView('dia');
      day.classList.add('revealed');
      day.style.display = '';
      setOpen(day, true);
      day.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
      flash(day);
    }
    function gotoItem(id: string) {
      const el = document.getElementById('i-' + id);
      if (!el) return;
      const day = el.closest<HTMLElement>('.wt-day')!;
      switchView('dia');
      day.classList.add('revealed');
      day.style.display = '';
      setOpen(day, true);
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      flash(el);
    }
    function handleHash() {
      const h = decodeURIComponent(location.hash.slice(1));
      if (h.startsWith('d-') || h.startsWith('s-')) gotoDay(h.slice(2), false);
      else if (h.startsWith('i-')) gotoItem(h.slice(2));
    }
    window.addEventListener('hashchange', handleHash);
    window.addEventListener('p3r:goto-day', (e: any) => { history.replaceState(null, '', '#d-' + e.detail); gotoDay(e.detail); });
    window.addEventListener('p3r:goto-item', (e: any) => gotoItem(e.detail));

    function nextPending() {
      for (const d of dayEls) for (const i of itemsOf.get(d)!) if (!store.has(i.dataset.check!)) { gotoItem(i.id.slice(2)); return; }
      alert('🎉 ¡No te queda nada pendiente!');
    }
    document.getElementById('btn-next')!.addEventListener('click', nextPending);
    document.getElementById('fab-next')!.addEventListener('click', nextPending);

    // ---------- fecha actual / spoilers / filtros ----------
    const spoilerBox = document.getElementById('opt-spoilers') as HTMLInputElement;
    const hideDoneBox = document.getElementById('opt-hide-done') as HTMLInputElement;
    spoilerBox.addEventListener('change', () => store.set('cfg:spoilers', spoilerBox.checked ? 1 : 0));
    hideDoneBox.addEventListener('change', () => store.set('cfg:hideDone', hideDoneBox.checked ? 1 : 0));

    function currentDay(): HTMLElement | null {
      const md = store.get<string>('cfg:date', '');
      if (!md) return null;
      const o = dateOrd(md);
      let best: HTMLElement | null = null;
      for (const d of dayEls) if (Number(d.dataset.ord) <= o) best = d;
      return best;
    }
    function applyFilters() {
      spoilerBox.checked = store.has('cfg:spoilers');
      hideDoneBox.checked = store.has('cfg:hideDone');
      const md = store.get<string>('cfg:date', '');
      const o = md ? dateOrd(md) : Infinity;
      const today = currentDay();
      document.body.classList.toggle('spoilers-on', spoilerBox.checked && !!md);
      for (const d of dayEls) {
        d.classList.toggle('future', Number(d.dataset.ord) > o);
        d.classList.toggle('today', d === today);
        d.style.display = hideDoneBox.checked && d.classList.contains('all-done') && d !== today ? 'none' : '';
      }
    }

    store.subscribe((changed) => {
      if (changed.some((k) => k.startsWith('c:') || k.startsWith('cfg:'))) updateAll();
    });
    updateAll();

    // al entrar: hash → ese día; si no, abrir el día actual del juego
    if (location.hash) handleHash();
    else {
      const t = currentDay();
      if (t) { setOpen(t, true); requestAnimationFrame(() => t.scrollIntoView({ block: 'start' })); }
    }

    // pestañas de mes: resaltar la del mes visible
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        document.querySelectorAll('.month-tab').forEach((t) => t.classList.toggle('active', (t as HTMLElement).dataset.tab === (e.target as HTMLElement).id));
      }
    }, { rootMargin: '-40% 0px -55% 0px' });
    monthEls.forEach((m) => io.observe(m));
  </script>
</Layout>
