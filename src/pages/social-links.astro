---
import Layout from '../layouts/Layout.astro';
import { ARCANA, SL_ROUTE, DAYS } from '../data/walkthrough';

const linked = ['Junpei', 'Akihiko', 'Ken', 'Koromaru', 'Shinjiro', 'Ryoji'];
// episodios vinculados: "(Episodio de X N)"
const episodes: Record<string, { n: number; date: string; dayId: string }[]> = Object.fromEntries(linked.map((n) => [n, []]));
for (const d of DAYS) for (const s of d.slots) for (const it of s.items) {
  for (const m of [it.text, ...(it.sub ?? [])].join(' ').matchAll(/Episodio de (\w+) (\d+)/g)) {
    const list = episodes[m[1]];
    if (list && !list.some((e) => e.n === Number(m[2]))) list.push({ n: Number(m[2]), date: d.date, dayId: d.id });
  }
}
const routeData = Object.fromEntries(Object.entries(SL_ROUTE).map(([k, v]) => [k, v.map((r) => ({ r: r.rank, date: r.date }))]));
---
<Layout title="Vínculos Sociales" section="sl" description="Los 22 Vínculos Sociales de Persona 3 Reload: seguimiento de rango y ruta completa con fechas y respuestas">

  <section class="page-hero">
    <p class="hero-eyebrow">22 Arcanos · Rango a Rango</p>
    <h1 class="page-title"><span>Social</span> Links</h1>
    <p class="page-subtitle">
      Anotá en qué rango vas con cada vínculo y mirá cuándo y cómo sube según la guía, con las respuestas de cada encuentro.
    </p>
  </section>

  <div class="content-wrap">
    <div class="track-progress" data-pagefind-ignore>
      <strong class="wt-progress-label">Vínculos al máximo: <span id="sl-maxed">0/22</span></strong>
      <div class="wt-progress-track"><div class="wt-progress-fill" id="sl-bar"></div></div>
    </div>

    <div class="card-grid">
      <div class="card">
        <span class="card-icon">👤</span>
        <div class="card-title">Persona del mismo arcano</div>
        <p>Llevá equipada una Persona del arcano del vínculo: multiplica los puntos de cada respuesta por 1,51. La guía te dice cuáles llevar antes de cada tanda.</p>
      </div>
      <div class="card">
        <span class="card-icon">✨</span>
        <div class="card-title">Encanto al máximo</div>
        <p>Maxear Encanto suma otro multiplicador de 1,51 a las respuestas. Por eso la guía prioriza Encanto temprano.</p>
      </div>
      <div class="card">
        <span class="card-icon">💬</span>
        <div class="card-title">Puntos por respuesta</div>
        <p><strong>+3</strong> la mejor · <strong>+2</strong> buena · <strong>+1</strong> neutral · <strong>+0</strong> mala. En el rango 10 no importa lo que digas.</p>
      </div>
      <div class="card">
        <span class="card-icon">📅</span>
        <div class="card-title">Ruta de la guía</div>
        <p>Las fechas de abajo salen del walkthrough: si seguís ese orden llegás a maxear los 22 en una sola partida.</p>
      </div>
    </div>

    <nav class="quick-nav" style="margin-top:2rem" data-pagefind-ignore>
      {ARCANA.map((a) => <a href={`#${a.key}`}>{a.name}</a>)}
      <a href="#episodios">Episodios vinculados</a>
    </nav>

    <div class="sl-grid">
      {ARCANA.map((a) => {
        const route = SL_ROUTE[a.key];
        return (
          <article class="sl-card" data-sl={a.key}>
            <div class="sl-top">
              <div>
                <h2 class="sl-name" id={a.key}>{a.name} — {a.who}</h2>
              </div>
              <label class="sl-rank" data-pagefind-ignore>
                <select data-bind={`sl:${a.key}`} data-type="number" aria-label={`Rango de ${a.name}`}>
                  <option value="">R–</option>
                  {Array.from({ length: 11 }, (_, i) => <option value={i}>{i === 10 ? 'MAX' : `R${i}`}</option>)}
                </select>
              </label>
            </div>
            <div class="sl-pips" aria-hidden="true">{Array.from({ length: 10 }, (_, i) => <span class="sl-pip" data-pip={i + 1}></span>)}</div>
            <div class="sl-status" data-status data-pagefind-ignore></div>
            {route.length > 0 && (
              <details class="sl-route">
                <summary>Ruta de la guía ({route.length} rangos)</summary>
                <ol>
                  {route.map((r) => (
                    <li data-rank={r.rank}>
                      <strong>R{r.rank}</strong> · <a href={`/walkthrough#${r.itemId ? `i-${r.itemId}` : `d-${r.dayId}`}`}>{r.date}</a> · {r.action}
                      {r.answers.length > 0 && <span class="ans">{r.answers.join(' · ')}</span>}
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </article>
        );
      })}
    </div>

    <div id="episodios" style="margin-top:3rem">
      <div class="section-label">Compañeros sin Social Link</div>
      <h2 class="section-title">Episodios vinculados</h2>
      <p class="muted" style="margin-bottom:1rem">Junpei, Akihiko, Ken, Koromaru, Shinjiro y Ryoji tienen episodios en lugar de vínculo. Marcá los que ya viste.</p>
      <div class="sl-grid">
        {linked.map((n) => (
          <div class="sl-card">
            <div class="sl-name">{n}</div>
            <div class="track-list" style="margin-top:0.5rem">
              {episodes[n].sort((a, b) => a.n - b.n).map((e) => (
                <div class="track-row" data-check={`x:ep-${n}-${e.n}`}>
                  <span class="wt-checkmark" aria-hidden="true"></span>
                  <div class="track-name" style="font-size:0.92rem">Episodio {e.n}</div>
                  <a class="track-date" href={`/walkthrough#d-${e.dayId}`}>{e.date} →</a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script type="application/json" id="sl-route" set:html={JSON.stringify(routeData)}></script>
  <script>
    import { store, dateOrd } from '../lib/store';
    const ROUTE: Record<string, { r: number; date: string }[]> = JSON.parse(document.getElementById('sl-route')!.textContent!);
    const cards = [...document.querySelectorAll<HTMLElement>('[data-sl]')];

    function render() {
      const md = store.get<string>('cfg:date', '');
      const o = md ? dateOrd(md) : -1;
      let maxed = 0;
      for (const c of cards) {
        const key = c.dataset.sl!;
        const mine = store.get<number | null>(`sl:${key}`, null);
        const route = ROUTE[key] ?? [];
        const exp = o < 0 ? null : route.filter((r) => dateOrd(r.date) <= o).reduce((a, r) => Math.max(a, r.r), 0);
        const next = route.find((r) => (mine ?? 0) < r.r);
        if (mine === 10) maxed++;
        c.classList.toggle('maxed', mine === 10);
        c.classList.toggle('behind', mine != null && exp != null && mine < exp);
        c.querySelectorAll<HTMLElement>('[data-pip]').forEach((p) => {
          const n = Number(p.dataset.pip);
          p.classList.toggle('on', mine != null && n <= mine);
          p.classList.toggle('exp', exp != null && n <= exp);
        });
        c.querySelectorAll<HTMLElement>('li[data-rank]').forEach((li) => li.classList.toggle('done', mine != null && Number(li.dataset.rank) <= mine));
        const st = c.querySelector<HTMLElement>('[data-status]')!;
        const parts: string[] = [];
        if (mine === 10) parts.push('<span class="ok">✓ Maxeado</span>');
        else if (next) parts.push(`Próximo: R${next.r} el ${next.date}`);
        if (exp != null && mine != null && mine < exp) parts.push(`<span class="warn">la guía va en R${exp}</span>`);
        else if (exp != null && mine == null && exp > 0) parts.push(`la guía va en R${exp}`);
        st.innerHTML = parts.join(' · ');
      }
      document.getElementById('sl-maxed')!.textContent = `${maxed}/22`;
      (document.getElementById('sl-bar') as HTMLElement).style.width = `${Math.round((maxed / 22) * 100)}%`;
    }
    store.subscribe((ch) => { if (ch.some((k) => k.startsWith('sl:') || k === 'cfg:date')) render(); });
    render();
  </script>
</Layout>
